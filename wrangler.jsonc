
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gods-eye-view",
  "main": "./worker.js",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
}
